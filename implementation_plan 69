    ```json
    {
      "thought": "Deep explanation of what is on screen and why this action was selected",
      "action": {
        "type": "click" | "type" | "select" | "press_key" | "scroll" | "navigate" | "done",
        "tag_id": 4,
        "value": "text or key",
        "description": "Short action summary"
      },
      "is_done": false
    }
