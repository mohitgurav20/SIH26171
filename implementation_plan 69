### Component 3: Closed-Loop ReAct Controller (`extension/background.js`)

#### [MODIFY] [extension/background.js](file:///c:/Users/mayab/OneDrive/Desktop/test/extension/background.js)
1. **Replace `decomposeGoalIntoSteps` + `runStepQueue` with `runAutonomousReActLoop`**:
   ```javascript
   async function runAutonomousReActLoop(tabId, goal) {
     let history = [];
     let turn = 0;
     const MAX_TURNS = 100; // Supports long multi-step workflows

     activeTask = { goal, status: 'running', turn: 0 };
     broadcastStatus('thinking', `Starting autonomous task: "${goal}"`);

     while (turn < MAX_TURNS) {
       // 1. Observe
       const domData = await getTabDom(tabId);
       const alerts = await getTabAlerts(tabId);
       const screenshot = await captureTabSanitized(tabId);

       // 2. Reason (Server Gateway)
       const decision = await fetchAgentStep({
         goal,
         pageUrl: tab.url,
         pageTitle: tab.title,
         elements: domData.elements,
         alerts,
         screenshotB64: screenshot.b64,
         history
       });

       // 3. Live Thought Streaming to UI
       broadcastStatus('thinking', decision.thought);

       // 4. Completion Check
       if (decision.is_done) {
         const verified = await verifyGoalAccomplished(tabId, goal);
         if (verified) {
           broadcastStatus('online', `✓ Goal completed: ${goal}`);
           break;
         }
       }

       // 5. Grounded Execution
       const execResult = await executeActionOnTab(tabId, decision.action);
       history.push({
         turn,
         action: decision.action.type,
         target: decision.action.description || decision.action.tag_id,
         value: decision.action.value,
         thought: decision.thought,
         success: execResult.success,
         error: execResult.error
       });

       // Keep history sliding window (last 6 turns)
       if (history.length > 6) history.shift();

       turn++;
       await sleep(350);
     }
   }
   ```
2. **Cross-Page Navigation Continuity**:
   * When an action navigates to a new URL, `chrome.tabs.onUpdated` detects completion and resumes `runAutonomousReActLoop` seamlessly on the new page.
3. **Loop Detection & Self-Healing**:
   * If the agent attempts the exact same failing action 2 times, it injects a warning into the prompt:
     `"WARNING: Previous action failed with error. You MUST try an alternative approach."`

